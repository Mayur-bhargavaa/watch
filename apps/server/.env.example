# Copy to apps/server/.env (never commit the real file). The server REFUSES to start without the first two.

# MongoDB connection string (use a dedicated least-privilege user, not an Atlas admin)
MONGODB_URI=mongodb://127.0.0.1:27017/

# Random secret, >= 16 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma separated list of web origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000

# Public URL of the web app (used in password-reset links). Defaults to the first CORS origin.
WEB_BASE_URL=http://localhost:3000

# Email (signup confirmation + password reset). REQUIRED in production: the server refuses to boot without it.
# Separate variables are easiest (no URL-encoding of "@" in the username/password):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465            # 465 = implicit TLS, 587 = STARTTLS
# SMTP_USER=you@example.com
# SMTP_PASS=
# MAIL_FROM=Watch <you@example.com>
# MAIL_REPLY_TO=                      # optional; leave unset for send-only ("do not reply") mail
# (or a single SMTP_URL=smtps://user:pass@host:465). In development, with none of these set, links are only printed to the log.
# NODE_ENV=production also requires CORS_ORIGINS to be set and https://

# Browser session cookie. In production serve web+API over https; use COOKIE_SAMESITE=none only if they are
# on different registrable domains (it forces Secure).
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=1
# SESSION_MAX_AGE_SEC=2592000

PORT=4000
HOST=0.0.0.0

# Optional tuning
# JWT_EXPIRES_IN=30d
# RATE_LIMIT_GLOBAL_MAX=600     # requests / minute / IP
# RATE_LIMIT_LOGIN_MAX=10       # login attempts / 15 min / (ip,email)
# RATE_LIMIT_REGISTER_MAX=20    # registrations / hour / IP

# Web Push (banners when the browser/tab is closed). OPTIONAL: if unset the server generates a key pair once and keeps it in MongoDB.
# To manage it yourself instead (safer), generate once per environment and keep the private key secret:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Behind nginx / Cloudflare / a load balancer set this, or every user shares ONE rate-limit bucket.
# true | number of proxy hops (e.g. 1) | comma separated proxy IPs/CIDRs
# TRUST_PROXY=1

# ---- Subscriptions (Watch+). See /BILLING.md. Never commit real values. ----
# off  = payments disabled (default; checkout answers 503)
# mock = development only: fake checkout + /api/billing/mock/* endpoints (REFUSED when NODE_ENV=production)
# live = real payments; the server refuses to boot unless a provider is fully configured
# BILLING_MODE=off

# Razorpay (India, INR: UPI, cards, netbanking). Dashboard > Account & Settings > API Keys
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Dashboard > Account & Settings > Webhooks: the secret you type when creating the webhook
# RAZORPAY_WEBHOOK_SECRET=
# Dashboard > Subscriptions > Plans: create a monthly and a yearly plan and paste their plan_ ids
# RAZORPAY_PLAN_PLUS_MONTHLY=
# RAZORPAY_PLAN_PLUS_YEARLY=

# Stripe (everyone else: USD / EUR / GBP). Dashboard > Developers > API keys (use the TEST key first)
# STRIPE_SECRET_KEY=
# Dashboard > Developers > Webhooks > your endpoint > Signing secret
# STRIPE_WEBHOOK_SECRET=
# Dashboard > Product catalog > Watch+ > each recurring price id (price_...), one per interval and currency
# STRIPE_PRICE_PLUS_MONTHLY_USD=
# STRIPE_PRICE_PLUS_MONTHLY_EUR=
# STRIPE_PRICE_PLUS_MONTHLY_GBP=
# STRIPE_PRICE_PLUS_YEARLY_USD=
# STRIPE_PRICE_PLUS_YEARLY_EUR=
# STRIPE_PRICE_PLUS_YEARLY_GBP=
# WEB_BASE_URL (above) is where Stripe/Razorpay send people back after paying

# --- Cineverse (movie / TV discovery at /discover). See CINEVERSE.md. Leave empty to keep it switched off. ---
# TMDB (catalog metadata, artwork, trending, recommendations). Needed for MOVIES and the full catalog. Without it and with
# TVMAZE_ENABLED=1 (below) Discover runs in TV-only "TVmaze mode"; with both off every catalog route answers 503.
# Create a free account at https://www.themoviedb.org/settings/api. Use EITHER the v4 "API Read Access Token"
# (preferred) OR the v3 "API Key". Free keys are for non-commercial use; commercial use needs a TMDB licence agreement.
TMDB_READ_TOKEN=
TMDB_API_KEY=
# Watchmode (streaming availability and provider links per region). OPTIONAL: without it the app works but hides
# "where to watch" and the platform filters. https://api.watchmode.com (a paid plan is needed for production use).
WATCHMODE_API_KEY=
# Streaming Availability API by Movie of the Night (where to watch, incl. India). OPTIONAL, tiny free quota.
# Get a key at https://developers.movieofthenight.com (Developers Platform key sent as the X-API-Key header; RapidAPI keys are
# NOT supported). Free plan: 1,000 requests a month, hard cap, commercial use allowed, credit "Availability from Movie of the
# Night" is shown in the app. It is only called from a title page opened by a signed-in user and is cached 24 h (see CINEVERSE.md).
STREAMING_AVAILABILITY_API_KEY=
# Monthly request limit of your plan (default 1000). Calls stop at 90% of it, status reports quotaLow and the UI says
# "Availability data is paused for this month" until the next UTC month. The counter lives in Mongo (collection catalog_quota).
STREAMING_AVAILABILITY_MONTHLY_LIMIT=1000
# Which availability providers to try and in what order (comma list of streamingavailability, watchmode). The first configured
# provider whose quota is not stopped answers; the next one is the fallback on failure or quota stop.
AVAILABILITY_PROVIDER_ORDER=streamingavailability,watchmode
# TVmaze (TV shows, episodes, schedules; NO key, free, data is CC BY-SA 4.0 and the app credits TVmaze). Default on; 0 disables.
# With a TMDB key it only enriches TV title pages (episodes, next episode, a second rating). Without one it powers TVmaze mode.
TVMAZE_ENABLED=1
# User-Agent sent to TVmaze (descriptive, printable ASCII). Empty = "WatchPartyCatalog/1.0 (+https://watch.stitchbyte.in)".
TVMAZE_USER_AGENT=
# YouTube Data API v3 (optional, only to find an official trailer id). Google Cloud Console > APIs & Services > Credentials.
YOUTUBE_API_KEY=
# ISO 3166-1 alpha-2 region used when the request carries no country (CDN header or ?region=). Default IN.
CATALOG_DEFAULT_REGION=IN
# Max entries of the in-memory catalog cache (50 to 20000, default 1000).
CATALOG_CACHE_MAX_ENTRIES=
